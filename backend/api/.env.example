# Copy this file to .env (git-ignored) and fill in real values from your
# Supabase project (Project Settings -> API). Never commit .env.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# service_role key — SECRET. Bypasses Row Level Security entirely.
# Server-side only. Never expose this to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of origins allowed to call this API (your deployed
# site + local dev server). Example:
# ALLOWED_ORIGINS=https://adorworks.com,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080

# Port the API listens on locally. Hosting platforms (Render, Fly, etc.)
# usually set PORT themselves and this is ignored in production.
PORT=8787
