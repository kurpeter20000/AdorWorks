# Copy to .env.local (git-ignored) and fill in real values.
# Same Supabase project as the rest of AdorWorks — see
# ../backend/supabase/README.md for how it was set up.

# Project URL and PUBLISHABLE (anon) key — safe to be public, same values
# already used in ../js/supabase-config.js and ../staff/js/config.js.
# Row Level Security is what keeps these safe, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://cpiebggzbxshzvlzqdfn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET key — server-only, never exposed to the browser (no NEXT_PUBLIC_
# prefix). Needed for the few operations RLS can't express alone
# (provisioning accounts, audited state changes) — same pattern as
# ../backend/api/.env's SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Base URL this app is served from (used for auth redirect/callback
# URLs). Update for each environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
