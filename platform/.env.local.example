# Copy to .env.local (git-ignored) and fill in real values.
# Same Supabase project as the rest of AdorWorks — see
# ../backend/supabase/README.md for how it was set up.

# Project URL and PUBLISHABLE (anon) key — safe to be public, same values
# already used in ../js/supabase-config.js and ../staff/js/config.js.
# Row Level Security is what keeps these safe, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://cpiebggzbxshzvlzqdfn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET key — server-only, never exposed to the browser (no NEXT_PUBLIC_
# prefix). Needed for the few operations RLS can't express alone
# (provisioning accounts, audited state changes) — same pattern as
# ../backend/api/.env's SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Base URL this app is served from (used for auth redirect/callback
# URLs). Update for each environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Africa's Talking — phone verification SMS. Server-only, same pattern as
# SUPABASE_SECRET_KEY above. Get these from africastalking.com's dashboard.
# Set AFRICAS_TALKING_USERNAME=sandbox to use their test API (no real SMS
# sent) while developing.
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=

# Resend — transactional email (Stage 7). Server-only. Get an API key
# from resend.com; RESEND_FROM_EMAIL must be a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# MTN MoMo (Stage 7) — only used when ADORWORKS_FF_REAL_PAYMENTS=true
# (see lib/domain/featureFlags.ts; off by default, and the code path
# behind this flag has not been tested against a real sandbox in this
# repo). Get these from momodeveloper.mtn.com.
ADORWORKS_FF_REAL_PAYMENTS=
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=
