# Copy to .env.e2e.local (git-ignored). Never point this file at the
# production Supabase project. The E2E suite creates and deletes users and
# marketplace records with the secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-dedicated-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Both values are required. The project ref must exactly match the first
# hostname segment in NEXT_PUBLIC_SUPABASE_URL. Use "local" only for a local
# Supabase instance on localhost/127.0.0.1.
E2E_ALLOW_MUTATIONS=true
E2E_EXPECTED_SUPABASE_PROJECT_REF=your-dedicated-test-project

# Optional. Defaults to the locally running platform.
E2E_BASE_URL=http://localhost:3000
